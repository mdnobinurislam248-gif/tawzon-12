rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for general platform data like branding, categories and products
    match /brand_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /sales/{saleId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /app_state/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
